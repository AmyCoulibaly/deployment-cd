# ============================================================================
# e-Santé Sénégal — Variables d'environnement pour le déploiement
# ============================================================================
# Copiez ce fichier vers .env et renseignez les valeurs réelles.
# NE JAMAIS commiter le fichier .env dans Git.
# ============================================================================

# ---- Docker Hub ----
DOCKERHUB_USER=<votre_utilisateur_dockerhub>
BACKEND_TAG=latest
FRONTEND_TAG=latest

# ---- PostgreSQL ----
POSTGRES_USER=esante_user
POSTGRES_PASSWORD=<CHANGEZ_MOI_mot_de_passe_fort_postgres>
POSTGRES_DB=esante_senegal_prod

# ---- Backend Flask ----
SECRET_KEY=<CHANGEZ_MOI_cle_secrete_flask_min_32_caracteres>
JWT_SECRET_KEY=<CHANGEZ_MOI_cle_jwt_min_32_caracteres>
JWT_EXPIRES_HOURS=24
GUNICORN_WORKERS=4

# ---- CORS (origines autorisées, séparées par des virgules) ----
# En production, indiquer le domaine réel du frontend
CORS_ORIGINS=http://localhost

# ---- Port du frontend exposé sur l'hôte ----
FRONTEND_PORT=80
